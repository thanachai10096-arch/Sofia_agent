{
  "name": "sofia-agent",
  "version": "0.3.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "bin": {
    "sofia": "./dist/src/cli/index.js"
  },
  "scripts": {
    "license:check": "node scripts/check-license.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "cli": "tsx src/cli/index.ts",
    "start": "node dist/api/entrypoint.js",
    "desktop:live-smoke": "npm run build && node scripts/live-desktop-smoke.mjs",
    "discord:register-command": "node scripts/register-discord-command.mjs",
    "web:chat": "node scripts/web-chat-server.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
