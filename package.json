{
  "name": "sofia-agent",
  "version": "0.3.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "bin": {
    "sofia": "./dist/src/cli/index.js"
  },
  "scripts": {
    "license:check": "node scripts/check-license.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "cli": "tsx src/cli/index.ts",
    "desktop:live-smoke": "npm run build && node scripts/live-desktop-smoke.mjs",
    "start:api": "node dist/src/api/standalone.js",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "example:mock-api": "tsx examples/mock-api.ts",
    "benchmark:real-model": "node scripts/benchmark-real-model.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "optionalDependencies": {
    "playwright": "^1.55.0"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "assets/"
  ]
}
