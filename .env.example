# Model credentials belong in the deployment secret store, never in prompts or source.
# The router intentionally hides provider/model names from end users.
AI_GATEWAY_API_KEY=
SOFIA_MAX_STEPS=12
SOFIA_MAX_RETRIES=2

# Internal route model IDs (users never see these)
SOFIA_FAST_MODEL=
SOFIA_CODING_MODEL=
SOFIA_REASONING_MODEL=
SOFIA_VISION_MODEL=
SOFIA_AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1

# Agent execution policy (server/admin controlled; never supplied by end users)
SOFIA_ALLOW_TOOLS=true
SOFIA_ALLOW_NETWORK=false
SOFIA_ALLOW_SHELL=false
SOFIA_ALLOW_FILE_WRITE=true
SOFIA_MAX_TOOL_CALLS_PER_STEP=4

# Security boundaries
SOFIA_ALLOW_DESTRUCTIVE=false
SOFIA_MAX_RISK=high
SOFIA_BLOCKED_PATHS=.env,.git,node_modules,.sofia/secrets
# Required when network/browser access is enabled. Comma-separated hostnames.
SOFIA_ALLOWED_HOSTS=
