# Model provider: any OpenAI-compatible chat-completions endpoint.
# Run "sofia setup" to write these values to a private local .env file.
# Keep real API keys in environment variables or your deployment secret manager; never commit them.
SOFIA_MODEL_PROVIDER=custom
SOFIA_MODEL_BASE_URL=https://api.example.com/v1
SOFIA_MODEL_API_KEY=
SOFIA_MODEL=your-model-id
# Optional route-specific model IDs:
SOFIA_FAST_MODEL=
SOFIA_CODING_MODEL=
SOFIA_REASONING_MODEL=
SOFIA_VISION_MODEL=

# Backward-compatible legacy Gemini configuration (used only if generic model settings are absent).
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

SOFIA_MAX_STEPS=12
SOFIA_MAX_RETRIES=2

# Persistent storage for job records, run snapshots, and project memory.
# Set an absolute path on a persistent volume for restart survival; unset uses OS temp storage.
SOFIA_STATE_DIR=

# Agent execution policy (server/admin controlled; never supplied by end users)
SOFIA_ALLOW_TOOLS=true
SOFIA_ALLOW_NETWORK=false
SOFIA_ALLOW_SHELL=false
SOFIA_ALLOW_FILE_WRITE=true
SOFIA_MAX_TOOL_CALLS_PER_STEP=4

# Security boundaries
SOFIA_ALLOW_DESTRUCTIVE=false
SOFIA_MAX_RISK=high
SOFIA_BLOCKED_PATHS=.env,.git,node_modules,.sofia/secrets
# Required when network/browser access is enabled. Comma-separated hostnames.
SOFIA_ALLOWED_HOSTS=

# Strong random secret for short-lived tool capabilities (required for distributed execution)
SOFIA_CAPABILITY_SECRET=

# Encryption secret for persistent security audit (use a long random secret)
SOFIA_AUDIT_SECRET=

# Optional hardened execution: docker runs commands with no network, dropped capabilities, memory/cpu/pid limits
SOFIA_SANDBOX_MODE=process
SOFIA_SANDBOX_IMAGE=node:22-alpine

# Optional Slack Events API receiver (api/slack/events.ts; deploy on a Node serverless host).
# Keep these secrets server-side. Empty allowlists deny all senders/channels.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_ALLOWED_USER_IDS=
SLACK_ALLOWED_CHANNEL_IDS=
# Use the same random >=32-character value on the receiver host and Sofia API service.
SOFIA_SLACK_CALLBACK_SECRET=
# Receiver-host credentials used to submit accepted tasks to Sofia API.
SOFIA_API_BASE_URL=
SOFIA_API_KEY=
