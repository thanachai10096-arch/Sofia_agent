# Explicit OpenAI-compatible provider registry. IDs are comma-separated.
# Configure every listed provider using SOFIA_PROVIDER_<ID>_BASE_URL, _API_KEY, and _MODEL.
# Routes use the first listed provider unless SOFIA_<ROUTE>_PROVIDER selects another configured ID.
# Never commit real API keys. No automatic cross-provider fallback is performed.
SOFIA_PROVIDER_IDS=primary
SOFIA_PROVIDER_PRIMARY_BASE_URL=
SOFIA_PROVIDER_PRIMARY_API_KEY=
SOFIA_PROVIDER_PRIMARY_MODEL=
# Optional route-specific provider/model overrides:
SOFIA_FAST_PROVIDER=
SOFIA_CODING_PROVIDER=
SOFIA_REASONING_PROVIDER=
SOFIA_VISION_PROVIDER=
SOFIA_FAST_MODEL=
SOFIA_CODING_MODEL=
SOFIA_REASONING_MODEL=
SOFIA_VISION_MODEL=

# Legacy Gemini configuration remains supported for existing deployments.
GEMINI_API_KEY=
GEMINI_MODEL=

SOFIA_MAX_STEPS=12
SOFIA_MAX_RETRIES=2

# Optional privacy-safe task efficiency telemetry (aggregate token counts, duration, verification).
# Disabled by default; writes workspace/principal-namespaced JSONL under SOFIA_STATE_DIR.
SOFIA_EFFICIENCY_METRICS_ENABLED=false

# Persistent storage for job records, run snapshots, and project memory.
# Set an absolute path on a persistent volume for restart survival; unset uses OS temp storage.
SOFIA_STATE_DIR=

# Agent execution policy (server/admin controlled; never supplied by end users)
SOFIA_ALLOW_TOOLS=true
SOFIA_ALLOW_NETWORK=false
SOFIA_ALLOW_SHELL=false
SOFIA_ALLOW_FILE_WRITE=true
SOFIA_MAX_TOOL_CALLS_PER_STEP=4

# Security boundaries
SOFIA_ALLOW_DESTRUCTIVE=false
SOFIA_MAX_RISK=high
SOFIA_BLOCKED_PATHS=.env,.git,node_modules,.sofia/secrets
# Required when network/browser access is enabled. Comma-separated hostnames.
SOFIA_ALLOWED_HOSTS=

# Strong random secret for short-lived tool capabilities (required for distributed execution)
SOFIA_CAPABILITY_SECRET=

# Encryption secret for persistent security audit (use a long random secret)
SOFIA_AUDIT_SECRET=

# Optional hardened execution: docker runs commands with no network, dropped capabilities, memory/cpu/pid limits
SOFIA_SANDBOX_MODE=process
SOFIA_SANDBOX_IMAGE=node:22-alpine
