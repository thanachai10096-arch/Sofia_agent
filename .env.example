# Sofia API authentication (required by the hosted API entrypoint).
# This key authenticates clients to Sofia; it is NOT a model-provider credential.
SOFIA_API_KEY=

# Optional API scopes. Approval permissions are deliberately opt-in; only grant them to trusted key holders.
# SOFIA_API_SCOPES=agent:run,agent:read,approval:read,approval:decide

# Model provider selection.
# Supported built-ins: openrouter, gemini, and anthropic. "custom" accepts any endpoint
# implementing the OpenAI Chat Completions-compatible API (for example local
# LM Studio/vLLM or a hosted compatible gateway). Credentials stay server-side.
# Leave SOFIA_MODEL_PROVIDER blank to auto-select only when one provider is configured.
# If multiple built-in provider keys are set, specify SOFIA_MODEL_PROVIDER explicitly.
SOFIA_MODEL_PROVIDER=

# Generic OpenAI-compatible endpoint (required when provider is "custom").
SOFIA_BASE_URL=
SOFIA_PROVIDER_API_KEY=
SOFIA_MODEL=
# Set to anthropic-messages only when the custom endpoint implements that native protocol.
SOFIA_MODEL_PROTOCOL=openai-compatible
# Optional DeepSeek thinking toggle: enabled or disabled. Unset preserves provider defaults.
SOFIA_MODEL_THINKING=
# Optional custom route overrides; default to SOFIA_MODEL when blank.
SOFIA_FAST_MODEL=
SOFIA_CODING_MODEL=
SOFIA_REASONING_MODEL=
SOFIA_VISION_MODEL=

# OpenRouter (optional built-in). Route overrides are optional.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_FAST_MODEL=
OPENROUTER_CODING_MODEL=
OPENROUTER_REASONING_MODEL=
OPENROUTER_VISION_MODEL=

# Gemini (optional built-in, direct OpenAI-compatible endpoint).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=
GEMINI_CODING_MODEL=
GEMINI_REASONING_MODEL=
GEMINI_VISION_MODEL=

# Anthropic (optional built-in, native Messages API).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=
ANTHROPIC_FAST_MODEL=
ANTHROPIC_CODING_MODEL=
ANTHROPIC_REASONING_MODEL=
ANTHROPIC_VISION_MODEL=

SOFIA_MAX_STEPS=12
SOFIA_MAX_RETRIES=2

# Persistent storage for job records, run snapshots, and project memory.
# Set an absolute path on a persistent volume for restart survival; unset uses OS temp storage.
SOFIA_STATE_DIR=

# Optional web research/news search (Brave Search API; keep this key server-side).
BRAVE_SEARCH_API_KEY=

# Optional MCP servers (admin-controlled JSON; leave blank to disable).
# Each server must list exact allowedTools. HTTP endpoints require HTTPS + SOFIA_ALLOWED_HOSTS.
# readOnlyTools is an operator-reviewed subset of allowedTools; remote MCP hints are not trusted.
# Omit readOnlyTools to keep all tools destructive by default.
# For HTTP auth, map header names to environment-variable names (never put secrets in JSON).
# Stdio commands must also appear exactly in SOFIA_MCP_STDIO_ALLOWED_COMMANDS.
SOFIA_MCP_SERVERS=
SOFIA_MCP_STDIO_ALLOWED_COMMANDS=

# Agent execution policy (server/admin controlled; never supplied by end users)
SOFIA_ALLOW_TOOLS=true
SOFIA_ALLOW_NETWORK=false
SOFIA_ALLOW_SHELL=false
SOFIA_ALLOW_FILE_WRITE=true
SOFIA_MAX_TOOL_CALLS_PER_STEP=4

# Security boundaries
SOFIA_ALLOW_DESTRUCTIVE=false
SOFIA_MAX_RISK=high
SOFIA_BLOCKED_PATHS=.env,.git,node_modules,.sofia/secrets
# Required when network/browser access is enabled. Comma-separated hostnames.
# For Brave web/news search, include api.search.brave.com.
SOFIA_ALLOWED_HOSTS=

# Strong random secret for short-lived tool capabilities (required for distributed execution)
SOFIA_CAPABILITY_SECRET=

# Encryption secret for persistent security audit (use a long random secret)
SOFIA_AUDIT_SECRET=

# Optional hardened execution: docker runs commands with no network, dropped capabilities, memory/cpu/pid limits
SOFIA_SANDBOX_MODE=process
SOFIA_SANDBOX_IMAGE=node:22-alpine


# Telegram (optional). Requires explicit user and chat allowlists.
SOFIA_MESSAGING_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_ALLOWED_CHAT_IDS=
# A single allowed Telegram user may use SOFIA_API_KEY above.
# For multiple users, provide a JSON object mapping EVERY allowed Telegram user ID
# to a distinct Sofia API key configured on the API server. Never reuse keys.
# Example: TELEGRAM_USER_API_KEYS_JSON={"123456789":"sofia-user-123-key","987654321":"sofia-user-987-key"}
TELEGRAM_USER_API_KEYS_JSON=
SOFIA_API_BASE_URL=

# Discord (optional). Both user and channel allowlists are mandatory.
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOWED_CHANNEL_IDS=
# Opt in to ordinary guild messages after enabling Message Content Intent in the Developer Portal.
DISCORD_GATEWAY_ENABLED=false
