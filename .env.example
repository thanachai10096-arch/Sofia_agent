# Model credentials belong in the deployment secret store, never in prompts or source.
# The router intentionally hides provider/model names from end users.
AI_GATEWAY_API_KEY=
SOFIA_MAX_STEPS=12
SOFIA_MAX_RETRIES=2

# Internal route model IDs (users never see these)
SOFIA_FAST_MODEL=
SOFIA_CODING_MODEL=
SOFIA_REASONING_MODEL=
SOFIA_VISION_MODEL=
SOFIA_AI_GATEWAY_URL=https://ai-gateway.vercel.sh/v1
