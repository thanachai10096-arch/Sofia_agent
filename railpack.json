{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22",
    "python": "3.12"
  },
  "steps": {
    "install": {
      "commands": [
        "...",
        {
          "src": "vendor/agent-reach",
          "dest": "vendor/agent-reach"
        },
        "python -m venv /opt/venv",
        "/opt/venv/bin/pip install --disable-pip-version-check -r vendor/agent-reach/requirements.txt",
        {
          "path": "/opt/venv/bin"
        },
        "python vendor/agent-reach/sofia_bridge.py --request-base64 eyJvcGVyYXRpb24iOiJjaGFubmVscyJ9"
      ],
      "inputs": [
        "..."
      ]
    }
  },
  "deploy": {
    "paths": [
      "/opt/venv/bin"
    ],
    "inputs": [
      "...",
      {
        "step": "install",
        "include": [
          "/opt/venv"
        ]
      }
    ],
    "aptPackages": [
      "...",
      "ffmpeg"
    ]
  }
}
